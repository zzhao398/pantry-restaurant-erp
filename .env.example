VITE_CLERK_PUBLISHABLE_KEY=

# Optional SERVER-ONLY settings. Leave DATABASE_URL empty for persistent local PGlite.
# Never add VITE_ to database credentials, commit .env, or paste passwords into chat.
DATABASE_URL=
PANTRY_BRAND_ID=10000000-0000-0000-0000-000000000001
PANTRY_REVIEWER_LABEL=Local operator (unverified)

# Default production build is the separate browser demo for the private static Site.
# Local pnpm dev always uses the real API. See docs/BACKEND.md before deploying a server.
